{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Custom API",
    "description": "This is the place to add your own path endpoints"
  },
  "servers": [
    {
      "description": "Endpoint for testing on localhost",
      "url": "http://localhost:8080/exist/apps/edep"
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "cookieAuth": {
        "type": "apiKey",
        "name": "teipublisher.com.login",
        "in": "cookie"
      }
    }
  },
  "paths": {
    "/edit/{collection}/": {
      "get": {
        "summary": "Landing page for places",
        "description": "Retrieve an HTML page expanded through eXist templating. This is used to load the top-level HTML pages, e.g. `index.html`.",
        "tags": [
          "view"
        ],
        "operationId": "vapi:html",
        "x-error-handler": "vapi:handle-error",
        "parameters": [
          {
            "name": "file",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "edit"
            }
          },
          {
            "name": "collection",
            "in": "path",
            "schema": {
              "type": "string",
              "default": "demo"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "HTML of the page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "The document was not found",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
