{
  "overwrite" : "default",
  "label" : "edep",
  "id" : "https://e-editiones.org/apps/edep",
  "extends" : [ "base10", "theme-base10", "registers", "docker", "edep-editor", "forms", "upload" ],
  "defaults": {
    "$replace": [ "languages" ],
    "data": "/db/apps/edep-data/data",
    "data-default": "",
    "languages": [ "en", "de" ]
  },
  "theme" : {
    "colors" : {
      "palette" : "edep-red",
      "palettes" : {
        "edep-red" : "palette-edep-red.css"
      }
    },
    "logo" : {
      "image" : "../images/icon.png",
      "width" : "95px",
      "height" : "48px"
    },
    "splash": {
        "image": "../images/icon.png"
    }
  },
  "pkg" : {
    "abbrev" : "edep"
  },
  "description" : "",
  "menu": {
    "$replace": [ "items" ],
    "items": [
      {
        "url": "browse.html",
        "id": "inscriptions"
      },
      {
        "url": "about.xml",
        "id": "about"
      },
      {
        "url": "howto.xml",
        "id": "instructions"
      }
    ]
  }
}