{
  "overwrite" : "default",
  "label" : "edep",
  "id" : "https://e-editiones.org/apps/edep",
  "extends" : [ "base10", "theme-base10", "registers", "docker", "edep-editor", "forms", "upload" ],
  "defaults": {
    "$replace": [ "languages" ],
    "data": "/db/apps/edep-data/data",
    "data-default": "",
    "languages": [ "en", "de" ],
    "browse": "browse-custom.html"
  },
  "theme" : {
    "colors" : {
      "palette" : "edep-red",
      "palettes" : {
        "edep-red" : "palette-edep-red.css"
      }
    },
    "logo" : {
      "image" : "../images/icon.png",
      "width" : "95px",
      "height" : "48px"
    },
    "splash": {
        "image": "../images/icon.png"
    },
    "fonts" : {
      "heading" : {
        "family" : "'Cinzel', 'Inter', 'Noto', serif"
      }
    }
  },
  "styles": [
    "https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&display=swap"
  ],
  "pkg" : {
    "abbrev" : "edep"
  },
  "description" : "",
  "menu": {
    "$replace": [ "items" ],
    "items": [
      {
        "url": "browse.html",
        "id": "inscriptions"
      },
      {
        "id": "people",
        "url": "people"
      },
      {
        "id": "places",
        "url": "places"
      },
      {
        "url": "about.xml",
        "id": "about"
      },
      {
        "url": "howto.xml",
        "id": "instructions"
      }
    ]
  },
  "features": {
    "register": {
        "config": {
            "$replace": true,
            "place": {
                "collection": "registers/places"
            },
            "person": {
                "collection": "registers/people"
            }
        }
    },
    "upload": {
        "enabled": true,
        "target": "workspace",
        "accept": ".xml, .tei, .odd, .docx, .md, .mei"
    },
    "edep": {
        "editor": {
            "enabled": true
        }
    }
  }
}